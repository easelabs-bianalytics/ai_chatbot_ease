# Copie para .env e preencha. Nunca commite o .env.
#
# Os nomes têm prefixo próprio (APP_, ANALYTICS_, AI_) de propósito: variáveis
# genéricas que já existam no .env (DATABASE_URL, POSTGRES_*, AWS_*) nunca são
# lidas pela aplicação — ver ADR-0002.

# --- Django -----------------------------------------------------------------
DEBUG=1
SECRET_KEY=troque-por-um-valor-aleatorio-antes-de-qualquer-uso-real
ALLOWED_HOSTS=localhost,127.0.0.1
# Produção: domínios COM esquema autorizados a enviar POST (login).
# Ex.: https://bi-chatbot.up.railway.app
CSRF_TRUSTED_ORIGINS=
TRUST_PROXY_SSL_HEADER=1

# --- Banco da APLICAÇÃO (conversas e auditoria) — nunca o RDS ---------------
APP_DB_NAME=bi_chatbot
APP_DB_USER=bi_chatbot
APP_DB_PASSWORD=bi_chatbot_dev
APP_DB_HOST=localhost
APP_DB_PORT=5434
# Se preenchida, vence as APP_DB_*. No Railway: ${{Postgres.DATABASE_URL}}.
# A aplicação se recusa a subir se isto apontar para *.rds.amazonaws.com.
APP_DATABASE_URL=
# Só se o Postgres dos testes não for o do docker-compose.
TEST_APP_DATABASE_URL=

# --- Celery + Redis (ADR-0003) ----------------------------------------------
REDIS_PORT=6381
REDIS_URL=redis://localhost:6381/0

# --- Banco analítico SINTÉTICO local (docker-compose) -----------------------
ANALYTICS_DB_PORT=5435
# Porta em que o banco sintético do docker-compose escuta no host. Fica
# separada de ANALYTICS_DB_PORT porque, com o RDS, essa aponta para o túnel
# (15432) — e o compose lê este arquivo sozinho.
ANALYTICS_DB_LOCAL_PORT=5435
ANALYTICS_DB_OWNER_PASSWORD=analytics_owner_dev
ANALYTICS_READONLY_PASSWORD=bi_readonly_dev

# --- Banco de negócio (ADR-0008) — usado a partir da Fase 3 -----------------
# String de conexão de um usuário SOMENTE LEITURA (D-01). Nunca o usuário
# administrador do RDS nem chaves de acesso da AWS.
# Local:  postgresql://bi_readonly:bi_readonly_dev@localhost:5435/analytics
# RDS:    postgresql://<usuario_leitura>:<senha>@<host>:5432/<banco>?sslmode=require
ANALYTICS_DATABASE_URL=
# Em desenvolvimento contra o RDS, os campos vão separados e o host aponta
# para o túnel SSM (infra/rds/abrir_tunel_wsl.sh):
# ANALYTICS_DB_HOST=127.0.0.1 · ANALYTICS_DB_PORT=15432 · ANALYTICS_DB_NAME=
# ANALYTICS_DB_USER= · ANALYTICS_DB_PASS= · ANALYTICS_DB_SSLMODE=require
# O tempo máximo da consulta e o limite de linhas ficam em
# app/knowledge/catalog.yaml, não aqui (O-06).

# --- IA (ADR-0016) ----------------------------------------------------------
AI_PROVIDER_API_KEY=
# "openai" liga o modelo real; vazio ou "fake" usa o provedor de mentira.
AI_PROVIDER=
# Opcional — quem escreve a consulta (padrão gpt-5.6-terra).
AI_PROVIDER_MODEL=
# Opcional — quem redige a resposta (padrão gpt-5.6-luna).
AI_ANSWER_MODEL=
# Opcional — esforço de raciocínio: low, medium (padrão) ou high.
AI_PLAN_EFFORT=
# Opcional — esforço da redação (padrão low).
AI_ANSWER_EFFORT=
# Opcional — teto de gasto do mês em dólares; vazio é sem limite. Ao atingir,
# a IA responde que o limite acabou em vez de continuar gastando (O-14).
AI_MONTHLY_BUDGET_USD=
# Opcional — tentativas com backoff antes de desistir (padrão 3).
AI_PROVIDER_MAX_ATTEMPTS=
# Opcional — mensagens anteriores da conversa no contexto (padrão 10).
AI_HISTORY_MAX_MESSAGES=
# As linhas enviadas ao modelo, o limite de linhas e o tempo máximo da
# consulta ficam em app/knowledge/catalog.yaml, não aqui: são decisão de
# catálogo e entram no hash que identifica cada resposta (ADR-0006).
